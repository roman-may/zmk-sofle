#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <keys_ch_mac.h>

#define BASE 0
#define SYMBOL 1
#define NAV 2
#define ADJUST 3
#define SYSTEM 4

&soft_off { hold-time-ms = <2000>; };

/ {
    // Activate ADJUST layer by pressing nav and symbol
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <SYMBOL NAV>;
            then-layer = <ADJUST>;
        };
    };

    // Hold SPACE + SYMBOL + NAV together (right thumb cluster) for SYSTEM.
    // The combo swallows all three presses, so ADJUST is not triggered alongside it.
    combos {
        compatible = "zmk,combos";
        combo_system {
            bindings = <&mo SYSTEM>;
            key-positions = <59 60 61>;
            layers = <BASE>;
            timeout-ms = <100>;
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                 7  8  9 10 11 12
                20 21 22 23 24 25
                33 34 35 36 37 38
                46 47 48 49 50 51
                59 60 61 62 63
            >; // All keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                13 14 15 16 17 18
                26 27 28 29 30 31
                39 40 41 42 43 44
                52 53 54 55 56 57
            >; // All keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    macros {
        // `, ~ and ^ are dead keys on macOS Swiss German, so a lone tap composes
        // with the next keystroke. Tapping the dead key then SPACE emits the
        // literal standalone character.
        ch_tilde: ch_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CH_TILDE &kp SPACE>;
        };
        ch_caret: ch_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CH_CARET &kp SPACE>;
        };
        ch_grave: ch_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CH_GRAVE &kp SPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";

// Layout without joystick (middle row) and rotary encoder (bottom left)
// -------------------------------------------------------------------------------------------
// |  ESC  |     |     |     |        |       | N/A |       |        |     |     |     | DEL |
// |  TAB  |  Q  |  W  |  E  |   R    |   T   | N/A |   Z   |   U    |  I  |  O  |  P  |  Ü  |
// | BKSPC |  A  |  S  |  D  |   F    |   G   | N/A |   H   |   J    |  K  |  L  |  Ö  |  Ä  |
// | CAPS  |  Y  |  X  |  C  |   V    |   B   | N/A |   N   |   M    |  ,  |  .  |  -  |     |
// |  N/A  | GUI |     | NAV | SYMBOL | ENTER | N/A | SPACE | SYMBOL | NAV |     |     |

            bindings = <
&kp ESC     &trans          &trans              &trans         &trans           &trans     &none  &trans       &trans          &trans         &trans            &trans                &kp DEL
&kp TAB     &kp CH_Q        &kp CH_W            &kp CH_E       &kp CH_R         &kp CH_T   &none  &kp CH_Z     &kp CH_U        &kp CH_I       &kp CH_O          &kp CH_P              &kp CH_U_UMLAUT
&kp BSPC    &hml LSHFT CH_A &hml  LCTRL CH_S    &hml LGUI CH_D &hml LALT CH_F   &kp CH_G   &none  &kp CH_H    &hmr LALT CH_J   &hmr RGUI CH_K &hmr RCTRL CH_L   &hmr RSHFT CH_O_UMLAUT &kp CH_A_UMLAUT
&kp CAPS    &kp CH_Y        &kp CH_X            &kp CH_C       &kp CH_V         &kp CH_B   &none  &kp CH_N     &kp CH_M        &kp CH_COMMA   &kp CH_DOT        &kp CH_MINUS          &trans
&none       &kp LGUI        &trans              &mo NAV        &mo SYMBOL       &kp RET    &none  &kp SPACE    &mo SYMBOL      &mo NAV        &trans            &trans
            >;
        };

        symbol_layer {
            display-name = "Symbol";
            
// -------------------------------------------------------------------------------
// |     |     |     |     |     |     | N/A |     |     |     |     |     |     |
// |     |  §  |     |  <  |  >  |  ^  | N/A |  &  |  {  |  }  |  '  |  `  |     |
// |     |  !  |  ?  |  =  |  /  |  @  | N/A |  |  |  (  |  )  |  "  |  $  |     |
// |     |  ~  |  +  |  *  |  \  |  %  | N/A |  #  |  [  |  ]  |     |     |     |
// | N/A |     |     |     |     |     | N/A |     |     |     |     |     |
            bindings = <
&trans  &trans              &trans           &trans           &trans            &trans          &none  &trans        &trans       &trans       &trans                &trans  &trans
&trans  &kp CH_SECTION      &trans           &kp CH_LT        &kp CH_GT         &ch_caret       &none  &kp CH_AMPS  &kp CH_LBRC  &kp CH_RBRC  &kp CH_SINGLE_QUOTE   &ch_grave      &trans
&trans  &kp CH_EXCLAMATION  &kp CH_QUESTION  &kp CH_EQUAL     &kp CH_SLASH      &kp CH_AT       &none  &kp CH_PIPE  &kp CH_LPAR  &kp CH_RPAR  &kp CH_DOUBLE_QUOTES  &kp CH_DOLLAR  &trans
&trans  &ch_tilde           &kp CH_PLUS      &kp CH_ASTERISK  &kp CH_BACKSLASH  &kp CH_PERCENT  &none  &kp CH_HASH  &kp CH_LBKT  &kp CH_RBKT  &trans                &trans         &trans
&none   &trans              &trans           &trans           &trans            &trans          &none  &trans        &trans       &trans       &trans                &trans
            >;
        };

        nav_layer {
            display-name = "nav";
// -------------------------------------------------------------------------------
// |     |     |     |     |     |     | N/A |     |     |     |     |     |     |
// |     |     |  7  |  8  |  9  |     | N/A | ⌥↑  | ⌘←  |  ↑  | ⌘→  |     |     |
// |     |     |  4  |  5  |  6  |  0  | N/A | ⌥↓  |  ←  |  ↓  |  →  |     |     |
// |     |     |  1  |  2  |  3  |     | N/A |     |     |     |     |     |     |
// | N/A |     |     |     |     |     | N/A |     |     |     |     |     |
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans &kp CH_N7  &kp CH_N8   &kp CH_N9   &trans  &none  &kp LA(UP)    &kp LG(LEFT)   &kp UP    &kp LG(RIGHT)  &trans  &trans
&trans        &trans &kp CH_N4  &kp CH_N5   &kp CH_N6   &kp CH_N0  &none  &kp LA(DOWN)  &kp LEFT       &kp DOWN  &kp RIGHT      &trans  &trans
&trans        &trans &kp CH_N1  &kp CH_N2   &kp CH_N3   &trans  &none  &trans     &trans    &trans    &trans     &trans   &trans
&none      &trans    &trans     &trans     &trans  &trans  &none  &trans     &trans    &trans     &trans     &trans
            >;
        };
          
        adjust_layer {
            display-name = "Adjust";
// ------------------------------------------------------------------------------------
// |     |     |     |     |     |     | N/A |     |      |       |       |     |     |
// |     |     | F7  | F8  | F9  | F10 | N/A |     | MUTE | VOL + | VOL - |     |     |
// |     |     | F4  | F5  | F6  | F11 | N/A |     | prev | pause | next  |     |     |
// |     |     | F1  | F2  | F3  | F12 | N/A |     |      |       |       |     |     |
// |     |     |     |     |     |     | N/A |     |      |       |       |     |
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans   &none  &trans  &trans      &trans        &trans        &trans  &trans
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F10  &none  &trans  &kp C_MUTE  &kp C_VOL_UP  &kp C_VOL_DN  &trans  &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &none  &trans  &kp C_PREV  &kp C_PP      &kp C_NEXT    &trans  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12  &none  &trans  &trans      &trans        &trans        &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans   &none  &trans  &trans      &trans        &trans        &trans
            >;
        };
          
        systen_layer {
            display-name = "System";
// --------------------------------------------------------------------------------------
// |     |     |     |     |     |            | N/A |     |     |     |     |     |     |
// |     |     |     |     |     | BT_CLR_ALL | N/A |     |     |     |     |     |     |
// |     |     | BT4 | BT5 |     |   BTCLR    | N/A |     |     |     |     |     |     |
// |     |     | BT1 | BT2 | BT3 |            | N/A |     |     |     |     |     |     |
// | N/A |     |     |     |     |            | N/A |     |     |     |     |     |
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans          &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans        &trans        &bt BT_CLR_ALL  &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &bt BT_CLR      &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans          &none  &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans        &trans        &trans        &trans          &none  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
