#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// OS-INDEPENDENT VARIANT — designed for the EurKEY layout.
// EurKEY (https://eurkey.steffen.bruentjen.eu) is a US-QWERTY base published
// identically for Windows, macOS, and Linux, with European letters on the
// AltGr (RA) layer. Set EurKEY as the active OS layout on every machine and
// this keymap produces the same characters everywhere — no locale header, no
// dead-key macros, no per-OS scancode swaps.
//
// Letters/digits/symbols use the standard US keycodes from keys.h.
// Umlauts use AltGr: ä = RA(A), ö = RA(O), ü = RA(U). Holding Shift on those
// keys yields Ä/Ö/Ü. Verify the exact AltGr positions against the EurKEY chart
// for your version; ß is RA(S) and € is RA(5) if you want to add them.

#define BASE 0
#define SYMBOL 1
#define NAV 2
#define ADJUST 3

&soft_off { hold-time-ms = <2000>; };

/ {
    // Activate ADJUST layer by pressing nav and symbol
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <SYMBOL NAV>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                 7  8  9 10 11 12
                20 21 22 23 24 25
                33 34 35 36 37 38
                46 47 48 49 50 51
                59 60 61 62 63
            >; // All keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                13 14 15 16 17 18
                26 27 28 29 30 31
                39 40 41 42 43 44
                52 53 54 55 56 57
            >; // All keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

// Layout without joystick (middle row) and rotary encoder (bottom left)
// -------------------------------------------------------------------------------------------------
// | ESC   |  1  |  2  |  3  |   4    |  5    | N/A |   6   |  7     |  8    |  9   |   0   |       |
// | TAB   |  Q  |  W  |  E  |   R    |  T    | N/A |   Z   |  U     |  I    |  O   |   P   |   Ü   |
// | BKSPC |  A  |  S  |  D  |   F    |  G    | N/A |   H   |  J     |  K    |  L   |   Ö   |   Ä   |
// | CAPS  |  Y  |  X  |  C  |   V    |  B    | N/A |   N   |  M     |  ,    |  .   |   -   |       |
// | N/A   |     |     | NAV | SYMBOL | ENTER | N/A | SPACE | SYMBOL | NAV   |      |       |

            bindings = <
&kp ESC     &kp N1        &kp N2         &kp N3       &kp N4       &kp N5  &none  &kp N6   &kp N7        &kp N8      &kp N9       &kp N0           &trans
&kp TAB     &kp Q         &kp W          &kp E        &kp R        &kp T   &none  &kp Z    &kp U         &kp I       &kp O        &kp P            &kp RA(U)
&kp BSPC    &hml LSHFT A  &hml LCTRL S   &hml LGUI D  &hml LALT F  &kp G   &none  &kp H    &hmr LALT J   &hmr RGUI K &hmr RCTRL L &hmr RSHFT RA(O) &kp RA(A)
&kp CAPS    &kp Y         &kp X          &kp C        &kp V        &kp B   &none  &kp N    &kp M         &kp COMMA   &kp DOT      &kp MINUS        &trans
&none       &trans        &trans         &mo NAV      &mo SYMBOL   &kp RET &none  &kp SPACE &mo SYMBOL   &mo NAV     &trans       &trans
            >;
        };

        symbol_layer {
            display-name = "symbol";

// ----------------------------------------------------------------------------------------
// |       |     |     |     |     |     | N/A |      |       |      |      |      |      |
// |       |  `  |  <  |  >  |  |  |  &  | N/A |      |  {    |  }   |  ^   |      |      |
// |       |  !  |  ?  |  =  |  /  |  @  | N/A |  #   |  (    |  )   |  "   |   $  |      |
// |       |  ~  |  +  |  *  |  \  |  %  | N/A |      |  [    |  ]   |  '   |      |      |
// |  N/A  |     |     |     |     |     | N/A |      |       |      |      |      |
            bindings = <
&trans  &trans      &trans   &trans    &trans    &trans     &none  &trans     &trans     &trans     &trans     &trans   &trans
&trans  &kp GRAVE   &kp LT   &kp GT    &kp PIPE  &kp AMPS   &none  &trans     &kp LBRC   &kp RBRC   &kp CARET  &trans   &trans
&trans  &kp EXCL    &kp QMARK &kp EQUAL &kp FSLH &kp AT     &none  &kp HASH   &kp LPAR   &kp RPAR   &kp DQT    &kp DLLR &trans
&trans  &kp TILDE   &kp PLUS &kp ASTRK &kp BSLH  &kp PRCNT  &none  &trans     &kp LBKT   &kp RBKT   &kp SQT    &trans   &trans
&none   &trans      &trans   &trans    &trans    &trans     &none  &trans     &trans     &trans     &trans     &trans
            >;
        };

        nav_layer {
            display-name = "nav";
// --------------------------------------------------------------------------------------------
// |     |  F1  |  F2  |  F3  |  F4  |  F5  | N/A |  F6  |  F7  |  F8   | F9   | F10  |  F11  |
// |     |      |  7   |  8   |  9   |      | N/A | PGUP | HOME |   ^   | END  | INS  |  F12  |
// |     |      |  4   |  5   |  6   |      | N/A | PGDN |   <- |   v   |  ->  | DEL  |       |
// |     |      |  1   |  2   |  3   |      | N/A |      |      |      |       |      |       |
// | N/A |      |      |      |      |      | N/A |      |      |      |       |      |
            bindings = <
&trans     &kp F1    &kp F2 &kp F3  &kp F4  &kp F5  &none   &kp F6     &kp F7    &kp F8    &kp F9     &kp F10  &kp F11
&trans     &trans    &kp 7  &kp 8   &kp 9   &trans  &none  &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp INS  &kp F12
&trans     &trans    &kp 4  &kp 5   &kp 6   &trans  &none  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &trans
&trans     &trans    &kp 1  &kp 2   &kp 3   &trans  &none  &trans     &trans    &trans    &trans     &trans   &trans
&none      &trans    &trans       &trans    &trans  &trans  &none  &trans     &trans    &trans    &trans     &trans
            >;
        };

        adjust_layer {
// --------------------------------------------------------------------------------------------------------------------------
// |        |  BT1    |  BT2       |   BT3   |   BT4   |   BT5   | N/A |      |      |         |          |         |       |
// | EXTPWR | BTCLR   | BT_CLR_ALL | RGB_SAD | RGB_SAI | RGB_EFF | N/A |      |      |         |          |         |       |
// |        | OUT_USB | OUT_BLE    |         |         |         | N/A |      |      |         |          |         |       |
// |        | SYS RST |            | BOOTLOA |         |         | N/A |      |      | SYS RST | SOFT OFF | BOOTLOA |       |
// |  N/A   |         |            |         |         |         | N/A |      |      |         |          |         |
            display-name = "adjust";
            bindings = <
&trans     &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &trans  &trans  &trans      &trans     &trans      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans        &none   &trans  &trans  &trans      &trans     &trans      &trans
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans        &none   &trans  &trans  &trans      &trans     &trans      &trans
&trans     &sys_reset    &trans          &bootloader   &trans        &trans        &none   &trans  &trans  &sys_reset  &soft_off  &bootloader &trans
&none      &trans        &trans          &trans        &trans        &trans        &none   &trans  &trans  &trans      &trans     &trans
            >;
        };
    };
};
